{
  "name": "sitekick",
  "version": "0.1.0",
  "private": true,
  "description": "Sitekick desktop app",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
