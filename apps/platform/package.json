{
  "name": "@sitekick/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "payload": "bun --bun ./node_modules/.bin/payload --disable-transpile",
    "generate:types": "bun --bun ./node_modules/.bin/payload generate:types --disable-transpile",
    "generate:importmap": "bun --bun ./node_modules/.bin/payload generate:importmap --disable-transpile",
    "migrate": "bun --bun ./node_modules/.bin/payload migrate --disable-transpile",
    "migrate:create": "bun --bun ./node_modules/.bin/payload migrate:create --disable-transpile",
    "migrate:status": "bun --bun ./node_modules/.bin/payload migrate:status --disable-transpile",
    "seed": "bun --bun scripts/seed.ts",
    "test": "bun test",
    "db:local": "bun scripts/local-db.ts",
    "vercel-build": "bash scripts/vercel-build.sh"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/linux-arm64",
    "esbuild",
    "unrs-resolver"
  ],
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@vercel/functions": "^3.10.1",
    "graphql": "^16.14.0",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^5"
  }
}
