# Postgres (Payload database). Locally, see README "Local database".
DATABASE_URL=

# Long random secret. Signs Payload's admin tokens, and (derived) the
# /api/v1 access tokens.
PAYLOAD_SECRET=

# Public origin. Unset locally and on previews; production sets it.
# Used for invite links (defaults to http://localhost:3100).
PLATFORM_URL=

# scripts/seed.ts: the first staff account
SEED_EMAIL=
SEED_PASSWORD=
