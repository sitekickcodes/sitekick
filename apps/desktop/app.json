{
    "$schema": "https://schema.native-sdk.dev/app/v1.json",
    "id": "co.sitekick.app",
    "name": "sitekick",
    "display_name": "Sitekick",
    "description": "Sitekick's agentic workspace for client sites.",
    "version": "0.1.0",
    "icons": [
        "assets/icon.png"
    ],
    "platforms": [
        "macos"
    ],
    "permissions": [
        "view",
        "command",
        "network",
        "credentials"
    ],
    "capabilities": [
        "native_views",
        "gpu_surfaces",
        "credentials",
        "store",
        "webview"
    ],
    "shell": {
        "windows": [
            {
                "label": "main",
                "title": "Sitekick",
                "width": 1100,
                "height": 720,
                "views": [
                    {
                        "label": "main-canvas",
                        "kind": "gpu_surface",
                        "fill": true,
                        "role": "App canvas",
                        "accessibility_label": "Sitekick",
                        "gpu_backend": "metal",
                        "gpu_pixel_format": "bgra8_unorm",
                        "gpu_present_mode": "timer",
                        "gpu_alpha_mode": "opaque",
                        "gpu_color_space": "srgb",
                        "gpu_vsync": true
                    },
                    {
                        "label": "preview",
                        "kind": "webview",
                        "parent": "main-canvas",
                        "url": "https://sitekick-platform.vercel.app/",
                        "x": 0,
                        "y": 0,
                        "width": 1,
                        "height": 1,
                        "layer": 20
                    }
                ]
            }
        ]
    },
    "security": {
        "navigation": {
            "allowed_origins": [
                "*"
            ],
            "external_links": {
                "action": "open_system_browser",
                "allowed_urls": [
                    "https://sitekick-platform.vercel.app/*",
                    "http://localhost:3100/*"
                ]
            }
        }
    },
    "web_engine": "system",
    "cef": {
        "dir": "third_party/cef/macos",
        "auto_install": false
    }
}
